diff --git a/vm-rust/src/player/xtra/legacy.rs b/vm-rust/src/player/xtra/legacy.rs
new file mode 100644
index 0000000..9b06ad5
--- /dev/null
+++ b/vm-rust/src/player/xtra/legacy.rs
@@ -0,0 +1,78 @@
+//! Stand-ins for the Director 6/7-era Xtras and XLib calls that the Danish
+//! Pixeline CD-ROMs (1997-2003) load at startup.
+//!
+//! The games only need these to exist: `openXLib` and `DateMaster_register`
+//! run unconditionally in `startMovie`, a Lingo error there aborts the whole
+//! start sequence, and an unknown `xtra("X").new()` does the same. None of
+//! them has a browser equivalent worth emulating (printing, CD date stamps),
+//! so instances accept any call and answer 0 — except KeyPoll's
+//! `bgOneKey()`, which the arcade-style mini games poll for the arrow keys.
+
+use crate::{
+    director::lingo::datum::Datum,
+    player::{
+        handlers::manager::BuiltInHandlerManager, reserve_player_mut, DatumRef, ScriptError,
+    },
+};
+
+const STUB_XTRAS: [&str; 4] = ["datemaster", "keypoll", "printomatic", "pmatic"];
+
+pub struct LegacyXtras;
+
+impl LegacyXtras {
+    pub fn is_stub_xtra(name: &str) -> bool {
+        STUB_XTRAS.contains(&name.to_ascii_lowercase().as_str())
+    }
+
+    pub fn has_handler(name: &str) -> bool {
+        match_ci!(name, {
+            "openXLib" | "closeXLib" | "DateMaster_register" | "bgOneKey"
+                | "getNthFileNameInFolder" | "installMenu" => true,
+            _ => false,
+        })
+    }
+
+    pub fn call_handler(name: &str, args: &Vec<DatumRef>) -> Result<DatumRef, ScriptError> {
+        match_ci!(name, {
+            "bgOneKey" => bg_one_key(args),
+            // An empty name ends the games' "Updates" folder scan.
+            "getNthFileNameInFolder" => alloc(Datum::String(String::new())),
+            _ => alloc(Datum::Void),
+        })
+    }
+
+    /// Any method on a stub instance, or on the Xtra itself
+    /// (`register(xtra "PrintOMatic", serial)`).
+    pub fn call_stub_method(handler_name: &str) -> Result<DatumRef, ScriptError> {
+        match_ci!(handler_name, {
+            "getVersion" => alloc(Datum::String("0".to_string())),
+            _ => alloc(Datum::Int(0)),
+        })
+    }
+}
+
+/// KeyPoll's `bgOneKey(code)`: the games pass Windows virtual-key codes on PC
+/// (`the platform` is "Windows,32" here). Translate the ones they use to the
+/// Mac key codes `keyPressed()` understands; letters are ASCII in both.
+fn bg_one_key(args: &Vec<DatumRef>) -> Result<DatumRef, ScriptError> {
+    let code = match args.first() {
+        Some(arg) => reserve_player_mut(|player| player.get_datum(arg).int_value())?,
+        None => return alloc(Datum::Int(0)),
+    };
+    let mac_code = match code {
+        37 => 123, // left
+        38 => 126, // up
+        39 => 124, // right
+        40 => 125, // down
+        32 => 49,  // space
+        13 => 36,  // return
+        27 => 53,  // escape
+        c => c,
+    };
+    let arg = alloc(Datum::Int(mac_code))?;
+    BuiltInHandlerManager::key_pressed(&vec![arg])
+}
+
+fn alloc(datum: Datum) -> Result<DatumRef, ScriptError> {
+    reserve_player_mut(|player| Ok(player.alloc_datum(datum)))
+}
