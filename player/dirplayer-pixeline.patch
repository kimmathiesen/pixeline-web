+/// Decode a RIFF/WAVE file (PCM 8/16-bit or IMA ADPCM) to mono 16-bit samples.
+fn decode_wav(b: &[u8]) -> Option<(u32, Vec<i16>)> {
+    let u16le = |o: usize| b.get(o..o + 2).map(|s| u16::from_le_bytes([s[0], s[1]]));
+    let u32le = |o: usize| b.get(o..o + 4).map(|s| u32::from_le_bytes([s[0], s[1], s[2], s[3]]));
+    let (mut fmt, mut data) = (None, None);
+    let mut p = 12;
+    while p + 8 <= b.len() {
+        let size = u32le(p + 4)? as usize;
+        let body = p + 8..(p + 8 + size).min(b.len());
+        match &b[p..p + 4] {
+            b"fmt " => fmt = Some(body),
+            b"data" => data = Some(body),
+            _ => {}
+        }
+        p += 8 + size + (size & 1);
+    }
+    let fmt = fmt?;
+    let data = &b[data?];
+    let f = fmt.start;
+    let (format, channels, rate) = (u16le(f)?, u16le(f + 2)? as usize, u32le(f + 4)?);
+    let (block_align, bits) = (u16le(f + 12)? as usize, u16le(f + 14)?);
+    if channels == 0 || !(3000..=768_000).contains(&rate) {
+        return None;
+    }
+    let mut frames: Vec<Vec<i32>> = Vec::new(); // per channel
+    match (format, bits) {
+        (1, 16) => {
+            for frame in data.chunks_exact(2 * channels) {
+                frames.push((0..channels).map(|c| i16::from_le_bytes([frame[2 * c], frame[2 * c + 1]]) as i32).collect());
+            }
+        }
+        (1, 8) => {
+            for frame in data.chunks_exact(channels) {
+                frames.push(frame.iter().map(|&s| ((s as i32) - 128) << 8).collect());
+            }
+        }
+        (0x11, 4) if block_align > 4 * channels => {
+            for block in data.chunks(block_align) {
+                if block.len() < 4 * channels {
+                    break;
+                }
+                let mut pred: Vec<i32> = (0..channels).map(|c| i16::from_le_bytes([block[4 * c], block[4 * c + 1]]) as i32).collect();
+                let mut idx: Vec<i32> = (0..channels).map(|c| (block[4 * c + 2] as i32).min(88)).collect();
+                frames.push(pred.clone());
+                // After the headers: 4-byte groups per channel, 8 samples each.
+                let body = &block[4 * channels..];
+                let mut group_frames: Vec<Vec<i32>> = Vec::new();
+                for (g, group) in body.chunks(4).enumerate() {
+                    let c = g % channels;
+                    if c == 0 {
+                        group_frames = vec![vec![0; channels]; 8];
+                    }
+                    for (i, byte) in group.iter().enumerate() {
+                        for (k, nib) in [byte & 0x0F, byte >> 4].into_iter().enumerate() {
+                            group_frames[i * 2 + k][c] = ima_step(&mut pred[c], &mut idx[c], nib);
+                        }
+                    }
+                    if c == channels - 1 {
+                        frames.extend(group_frames.drain(..));
+                    }
+                }
+            }
+        }
+        _ => return None,
+    }
+    let pcm = frames
+        .iter()
+        .map(|f| (f.iter().sum::<i32>() / f.len() as i32).clamp(-32768, 32767) as i16)
+        .collect();
+    Some((rate, pcm))
+}
+
+fn ima_step(pred: &mut i32, idx: &mut i32, nib: u8) -> i32 {
+    const STEPS: [i32; 89] = [
+        7, 8, 9, 10, 11, 12, 13, 14, 16, 17, 19, 21, 23, 25, 28, 31, 34, 37, 41, 45, 50, 55, 60, 66, 73, 80, 88,
+        97, 107, 118, 130, 143, 157, 173, 190, 209, 230, 253, 279, 307, 337, 371, 408, 449, 494, 544, 598, 658,
+        724, 796, 876, 963, 1060, 1166, 1282, 1411, 1552, 1707, 1878, 2066, 2272, 2499, 2749, 3024, 3327, 3660,
+        4026, 4428, 4871, 5358, 5894, 6484, 7132, 7845, 8630, 9493, 10442, 11487, 12635, 13899, 15289, 16818,
+        18500, 20350, 22385, 24623, 27086, 29794, 32767,
+    ];
+    const INDEX: [i32; 8] = [-1, -1, -1, -1, 2, 4, 6, 8];
+    let step = STEPS[*idx as usize];
+    let mut diff = step >> 3;
+    if nib & 1 != 0 { diff += step >> 2; }
+    if nib & 2 != 0 { diff += step >> 1; }
+    if nib & 4 != 0 { diff += step; }
+    if nib & 8 != 0 { *pred -= diff } else { *pred += diff }
+    *pred = (*pred).clamp(-32768, 32767);
+    *idx = (*idx + INDEX[(nib & 7) as usize]).clamp(0, 88);
+    *pred
+}
