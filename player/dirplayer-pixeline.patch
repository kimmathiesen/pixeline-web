+/// `None` if it holds a character Windows-1252 cannot represent.
+pub fn encode_win1252(s: &str) -> Option<Vec<u8>> {
+    s.chars()
+        .map(|c| if (c as u32) < 0x80 { Some(c as u8) } else { (0x80..=0xFFu8).find(|&b| win1252_byte_to_char(b) == c) })
+        .collect()
+}
+
+/// Re-encode a string decoded with [`decode_macroman`] to its original bytes.
+pub fn encode_macroman(s: &str) -> Option<Vec<u8>> {
+    s.chars()
+        .map(|c| if (c as u32) < 0x80 { Some(c as u8) } else { (0x80..=0xFFu8).find(|&b| macroman_byte_to_char(b) == c) })
+        .collect()
+}
