<?xml version="1.0"?>
<Container version="2">
  <Name>pixeline</Name>
  <Repository>__REGISTRY__/__OWNER__/pixeline-web:latest</Repository>
  <Registry>__GITEA_URL__/__OWNER__/-/packages/container/pixeline-web/latest</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>__GITEA_URL__/__OWNER__/pixeline-web</Support>
  <Project>__GITEA_URL__/__OWNER__/pixeline-web</Project>
  <Overview>De gamle danske Pixeline-spil i browseren, også på iPad. Læg dine egne ISO-filer i ISO-mappen; containeren gør dem klar ved opstart. Bygger på en rettet udgave af DirPlayer (GPL-3).</Overview>
  <Category>GameServers: MediaServer:Other</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <TemplateURL>__GITEA_URL__/__OWNER__/pixeline-web/raw/branch/main/unraid/pixeline.xml</TemplateURL>
  <Icon>__GITEA_URL__/__OWNER__/pixeline-web/raw/branch/main/unraid/icon.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DonateText/>
  <DonateLink/>
  <Requires>ISO-filer af Pixeline-spillene (dine egne).</Requires>
  <Config Name="WebUI" Target="8080" Default="8080" Mode="tcp" Description="Port til spil-siden" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="ISO-mappe" Target="/isos" Default="/mnt/user/isos/pixeline" Mode="ro" Description="Mappe med dine Pixeline ISO-filer (læses kun)" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/isos/pixeline</Config>
  <Config Name="Spildata" Target="/data" Default="/mnt/user/appdata/pixeline" Mode="rw" Description="Her gemmes de klargjorte spil" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/pixeline</Config>
</Container>
